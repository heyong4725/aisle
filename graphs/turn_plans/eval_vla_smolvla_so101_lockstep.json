{
 "barrier": "turn-barrier",
 "bridge": "dora-genesis",
 "bridge_inputs": {
  "gripper_cmd": {
   "output": "gripper_cmd_safe",
   "source": "budget-guard"
  },
  "joint_cmd": {
   "output": "joint_cmd_safe",
   "source": "budget-guard"
  },
  "reset": {
   "output": "bridge_reset",
   "source": "reset"
  }
 },
 "bridge_outputs": [
  "bridge_info",
  "depth_overhead",
  "gripper_state",
  "joint_state",
  "oracle_state",
  "reset_done",
  "rgb_overhead",
  "rgb_wrist",
  "seg_overhead",
  "sim_turn"
 ],
 "done_ports": {
  "done_0": "budget-guard",
  "done_3": "reset",
  "done_4": "rollout-client",
  "done_6": "task-state-machine",
  "done_7": "verifier-oracle",
  "done_8": "vla-policy-smolvla"
 },
 "participants": {
  "budget-guard": {
   "inputs": {
    "gripper_cmd": {
     "edge": "forward",
     "output": "gripper_cmd",
     "source": "vla-policy-smolvla"
    },
    "joint_cmd": {
     "edge": "forward",
     "output": "joint_cmd",
     "source": "vla-policy-smolvla"
    },
    "reset_done": {
     "edge": "forward",
     "output": "reset_done",
     "source": "reset"
    }
   },
   "outputs": [
    "gripper_cmd_safe",
    "guard_stats",
    "joint_cmd_safe",
    "turn_done",
    "violation"
   ],
   "verdict_bearing": false
  },
  "reset": {
   "inputs": {
    "reset": {
     "edge": "forward",
     "output": "reset",
     "source": "rollout-client"
    },
    "reset_done": {
     "edge": "forward",
     "output": "reset_done",
     "source": "dora-genesis"
    }
   },
   "outputs": [
    "bridge_reset",
    "reset_done",
    "reset_refused",
    "turn_done"
   ],
   "verdict_bearing": false
  },
  "rollout-client": {
   "inputs": {
    "episode_feedback": {
     "edge": "episodic",
     "output": "episode_feedback",
     "source": "task-state-machine"
    },
    "episode_result": {
     "edge": "episodic",
     "output": "episode_result",
     "source": "verifier-oracle"
    },
    "reset_done": {
     "edge": "episodic",
     "output": "reset_done",
     "source": "reset"
    },
    "reset_refused": {
     "edge": "episodic",
     "output": "reset_refused",
     "source": "reset"
    }
   },
   "outputs": [
    "episode_goal",
    "reset",
    "turn_done"
   ],
   "verdict_bearing": false
  },
  "task-state-machine": {
   "inputs": {
    "episode_goal": {
     "edge": "forward",
     "output": "episode_goal",
     "source": "rollout-client"
    },
    "episode_result": {
     "edge": "forward",
     "output": "episode_result",
     "source": "verifier-oracle"
    },
    "violation": {
     "edge": "episodic",
     "output": "violation",
     "source": "budget-guard"
    }
   },
   "outputs": [
    "episode_feedback",
    "target_request",
    "turn_done"
   ],
   "verdict_bearing": false
  },
  "verifier-oracle": {
   "inputs": {
    "episode_goal": {
     "edge": "forward",
     "output": "episode_goal",
     "source": "rollout-client"
    },
    "joint_state": {
     "edge": "forward",
     "output": "joint_state",
     "source": "dora-genesis"
    },
    "oracle_state": {
     "edge": "forward",
     "output": "oracle_state",
     "source": "dora-genesis"
    }
   },
   "outputs": [
    "episode_result",
    "turn_done"
   ],
   "verdict_bearing": false
  },
  "vla-policy-smolvla": {
   "inputs": {
    "joint_state": {
     "edge": "forward",
     "output": "joint_state",
     "source": "dora-genesis"
    },
    "reset_done": {
     "edge": "forward",
     "output": "reset_done",
     "source": "reset"
    },
    "rgb_overhead": {
     "edge": "forward",
     "output": "rgb_overhead",
     "source": "dora-genesis"
    },
    "rgb_wrist": {
     "edge": "forward",
     "output": "rgb_wrist",
     "source": "dora-genesis"
    },
    "target_request": {
     "edge": "forward",
     "output": "target_request",
     "source": "task-state-machine"
    }
   },
   "outputs": [
    "gripper_cmd",
    "joint_cmd",
    "turn_done"
   ],
   "verdict_bearing": false
  }
 }
}
