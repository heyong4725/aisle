{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aisle://registry/schema/capability.schema.json",
  "title": "AISLE capability manifest (SPEC 050 CAP-1)",
  "type": "object",
  "required": [
    "id",
    "kind",
    "provides",
    "requires",
    "inputs",
    "outputs",
    "embodiment",
    "safety_class",
    "eval",
    "origin",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "node",
        "subgraph"
      ]
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "schema",
          "rate_hz"
        ],
        "additionalProperties": false,
        "properties": {
          "schema": {
            "type": "string"
          },
          "rate_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "is_clock": {
            "type": "boolean",
            "default": false
          },
          "turn_edge": {
            "enum": [
              "episodic"
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "schema",
          "latency_class"
        ],
        "additionalProperties": false,
        "properties": {
          "schema": {
            "type": "string"
          },
          "latency_class": {
            "enum": [
              "hard_rt",
              "soft_rt",
              "best_effort"
            ]
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "default"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "float",
              "int",
              "bool",
              "str"
            ]
          },
          "default": {},
          "range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "embodiment": {
      "type": "object",
      "required": [
        "arm",
        "gripper"
      ],
      "additionalProperties": false,
      "properties": {
        "arm": {
          "type": "array",
          "items": {
            "enum": [
              "franka",
              "so101"
            ]
          },
          "minItems": 1
        },
        "gripper": {
          "enum": [
            "parallel",
            "any"
          ]
        },
        "base": {
          "type": "array",
          "items": {
            "enum": [
              "mobile"
            ]
          },
          "minItems": 1
        }
      }
    },
    "safety_class": {
      "enum": [
        "perception",
        "decision",
        "motion"
      ]
    },
    "eval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "suite",
            "pass_rate",
            "last_run"
          ],
          "additionalProperties": false,
          "properties": {
            "suite": {
              "type": "string"
            },
            "pass_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "last_run": {
              "type": "string"
            }
          }
        }
      ]
    },
    "origin": {
      "enum": [
        "hub",
        "agent-authored"
      ]
    },
    "trust_tier": {
      "enum": [
        "sandbox",
        "reviewed",
        "certified"
      ],
      "description": "§9.4 trust tier (ADR-40, issue #265). Optional: absent means the manifest predates the tier or is curated core. `sandbox` admits an id so graphs referencing it VALIDATE while making no quality claim — eval is null, it never counts as a library skill, and it can never hold safety_class motion (which, with ADR-5's rule that actuation outputs require the motion class, means a sandbox node can never emit actuation commands at all). `reviewed` is written by a registration that passed the measured floor. `certified` is reserved for the hardware promotion criteria and is not yet issued by any code path."
    },
    "specializes": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "ADR-41 (issue #264): the id of a capability sibling this entry is a NARROWER way of doing. Checked by lint: the target must exist, must share at least one `provides` entry, and must not be the manifest itself. This is the machine-checkable half of applicability — it lets search present a hierarchy instead of a flat list of same-capability entries with identical headline pass rates."
    },
    "applies_when": {
      "type": "string",
      "maxLength": 280,
      "description": "ADR-41 (issue #264): one sentence on the situation this entry is FOR — e.g. 'the transfer path sweeps a shelf at the carried box's level'. DELIBERATELY UNVERIFIABLE: no validator can check that prose matches behaviour, and the field is length-capped and advisory precisely so it is not mistaken for a guarantee. It exists because the alternative was leaving the reader with nothing."
    },
    "source": {
      "type": "string",
      "pattern": "^(pip:\\s*[^:\\s][^:]*|[^:]+)$",
      "description": "pip:<distribution> (padding allowed, but at least one non-whitespace distribution character \u2014 issue #35/PR #63: whitespace-only dists are schema errors) or a root-relative path"
    }
  }
}
